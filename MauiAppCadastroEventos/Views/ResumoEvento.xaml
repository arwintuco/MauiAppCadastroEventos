<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiAppCadastroEventos.Views.ResumoEvento"
             Title="ResumoEvento"
             NavigationPage.HasNavigationBar="False"
             BackgroundColor="{StaticResource Gray100}">
    
    <VerticalStackLayout Padding="20"
                         VerticalOptions="CenterAndExpand">

        <Label Text="Confirmação do Evento" TextColor="#880d1e"
               FontSize="40" FontFamily="Kalam"
               FontAttributes="Bold" HorizontalOptions="Center" />

        <Border Stroke="Black" StrokeShape="roundrectangle 10"
                StrokeThickness="1.5" Padding="20">
            
            <VerticalStackLayout>
                <Label Text="{Binding Nome}" TextColor="#880d1e" HorizontalOptions="Center"
                       FontFamily="KalamBold" FontSize="34" FontAttributes="Bold" />

                <BoxView HeightRequest="1" Color="#880d1e" Margin="1" />

                <Label Text="{Binding Local, StringFormat='Local: {0}'}"
                       FontSize="18" TextColor="Black"  FontAttributes="Bold"
                       Margin="10,10,0,0"/>

                <Label Text="{Binding NumeroParticipantes, StringFormat='Participantes: {0}'}"
                       FontSize="16" TextColor="black"
                       Margin="10,2,0,0"/>
                
                <Label Text="{Binding DataInicio, StringFormat='Início: {0:dd/MM/yyyy}'}"
                       FontSize="16" TextColor="Black"
                       Margin="10,2,0,0"/>
                
                <Label Text="{Binding DataTermino, StringFormat='Término: {0:dd/MM/yyyy}'}"
                       FontSize="16" TextColor="Black"
                       Margin="10,2,0,0"/>
                
                <Label Text="{Binding DuracaoDias, StringFormat='Duração: {0} dias'}"
                       FontSize="18" TextColor="black" FontAttributes="Bold"
                       Margin="10,2,0,10"/>


                <BoxView HeightRequest="1" Color="#880d1e" Margin="1" />

                <Label Text="Investimento Total:" TextColor="black"
                       FontSize="14" HorizontalOptions="Center"/>
                <Label Text="{Binding CustoTotal, StringFormat='R$ {0:F2}'}" TextColor="#880d1e"
                       FontSize="32" FontAttributes="Bold" HorizontalOptions="Center" />
            
            </VerticalStackLayout>
        </Border>

        <Button Text="Voltar ao Cadastro" Clicked="Button_Clicked" Margin="0,20,0,0"
                BackgroundColor="#880d1e" TextColor="#cbeef3" FontSize="18"
                CornerRadius="25" FontAttributes="Bold"/>
    </VerticalStackLayout>
</ContentPage>