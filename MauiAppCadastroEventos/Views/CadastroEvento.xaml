<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiAppCadastroEventos.Views.CadastroEvento"
             Title="CadastroEvento"
             NavigationPage.HasNavigationBar="False"
             BackgroundColor="{StaticResource Gray100}">

    <ScrollView>
        <VerticalStackLayout Padding="20"
                             VerticalOptions="CenterAndExpand">


            <Label Text="Cadastro de Evento" TextColor="#880d1e"
                   FontFamily="Kalam" FontSize="40"
                   FontAttributes="Bold" HorizontalTextAlignment="Center"/>
        
            <Border Stroke="Black" StrokeShape="roundrectangle 10"
                    StrokeThickness="1.5" Padding="20">

                <VerticalStackLayout Spacing="5">

                    <Label Text="Nome do Evento:" FontAttributes="Bold" FontSize="16" TextColor="Black"/>
                    <Entry x:Name="txtNome" Placeholder="Ex: Emapa 2026" TextColor="#cbeef3"
                           BackgroundColor="#880d1e" PlaceholderColor="#cbeef3"/>

                    <Label Text="Local do Evento:" FontAttributes="Bold" FontSize="16" TextColor="Black"/>
                    <Entry x:Name="txtLocal" Placeholder="Ex: Praça JK" TextColor="#cbeef3"
                           BackgroundColor="#880d1e" PlaceholderColor="#cbeef3"/>

                    <Border Stroke="Black" StrokeShape="roundrectangle 10"
                            StrokeThickness="1" Padding="20" Margin="0,10,0,10">

                        <VerticalStackLayout>

                            <Label Text="Data do Evento" FontAttributes="Bold" FontSize="16" TextColor="Black"/>

                            <HorizontalStackLayout Margin="20,10,0,0">

                                <Label Text="Início:" FontAttributes="Bold" TextColor="#880d1e"/>
                                <DatePicker x:Name="dtp_inicio" Format="dd/MM/yyyy" Margin="10,0,0,0"
                                            DateSelected="dtp_inicio_DateSelected" TextColor="black" BackgroundColor="#f49cbb"/>

                            </HorizontalStackLayout>
                            <HorizontalStackLayout Margin="20,20,0,0">

                                <Label Text="Término:" FontAttributes="Bold" TextColor="#880d1e"/>
                                <DatePicker x:Name="dtp_termino" Format="dd/MM/yyyy" Margin="10,0,0,0"
                                            TextColor="black" BackgroundColor="#f49cbb"/>

                            </HorizontalStackLayout>

                        </VerticalStackLayout>
                    </Border>

                    <Label Text="Número de Participantes:" FontAttributes="Bold" TextColor="Black"/>
                    <HorizontalStackLayout Spacing="15" Margin="20,0,0,5">
                        <Label Text="{Binding Source={x:Reference stp_participantes}, Path=Value, StringFormat='{0:F0} pessoa(s)'}"
                               VerticalOptions="Center" TextColor="#dd2d4a" FontAttributes="Bold"/>

                        <Stepper x:Name="stp_participantes" Minimum="1" Maximum="1000"
                                 Value="1" BackgroundColor="#dd2d4a"/>
                    </HorizontalStackLayout>

                    <Label Text="Custo por Participante:" FontAttributes="Bold" TextColor="black"/>
                    <Entry x:Name="txtCusto" Keyboard="Numeric" TextColor="#cbeef3"
                           Placeholder="R$ 0,00" PlaceholderColor="#cbeef3" BackgroundColor="#880d1e"/>

                </VerticalStackLayout>
            </Border>

            <Button Text="Finalizar Cadastro" Clicked="Button_Clicked" Margin="0,20,0,0"
                    BackgroundColor="#880d1e" TextColor="#cbeef3" FontSize="18"
                    CornerRadius="25" FontAttributes="Bold" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>